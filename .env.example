# Second Brain Environment Variables (.env)
# Copy to .env to customize local Docker Compose execution.

# Web frontend port on the host
WEB_PORT=3000

# Path to persistent memory (Obsidian vault + SQLite DB)
# On Tanix TX3 Mini: /mnt/memory
# On local workstation: ./data/memory or /path/to/vault
MEMORY_PATH=./data/memory

# Remote or local Intelligence Node
# For Penta Quad-GPU workstation: http://10.5.5.5:11434
# For local machine: http://localhost:11434
INTELLIGENCE_ENDPOINT=http://10.5.5.5:11434
INTELLIGENCE_MODEL=qwen-3.8-27b
