# OS and editor artifacts
.DS_Store
*.tmp
*.log

# Obsidian workspace cache
.obsidian/workspace*
.obsidian/cache

# Environment & local settings (contains secrets/endpoints)
settings.yml
.env
.env.local

# Local data & storage runtime mounts
data/
storage/
mnt/
*.db
*.sqlite
*.sqlite3

# Personal Vault Data in repo (keep directory skeletons with .gitkeep)
# Real knowledge lives on external 'memory' endpoint/mount.
raw/inbox/*
!raw/inbox/.gitkeep
raw/archive/*
!raw/archive/.gitkeep
processed/topics/*
!processed/topics/.gitkeep
processed/ideas/*
!processed/ideas/.gitkeep
processed/projects/*
!processed/projects/.gitkeep
processed/travel/*
!processed/travel/.gitkeep
processed/logs/*
!processed/logs/.gitkeep
processed/synthesis/*
!processed/synthesis/.gitkeep
